<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/flowfund_logo"
                android:contentDescription="FlowFund logo"
                android:layout_marginTop="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:gravity="center"
                android:text="Join a Group"
                android:textColor="#172B24"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Enter the invitation code provided by your group admin"
                android:textColor="#66756D"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etInvitationCode"
                android:layout_width="365dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#2B212321"
                android:gravity="center"
                android:inputType="textCapCharacters"
                android:letterSpacing="0.15"
                android:padding="12dp"
                android:text="F7K9-82P"
                android:textColor="#172B24"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnJoinGroup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Join Group"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#198754" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Don’t have the code?"
                android:textColor="#172B24"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Ask your group admin for an invitation code"
                android:textColor="#66756D"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
