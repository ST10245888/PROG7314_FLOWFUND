<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="20dp">

    <!-- BACK BUTTON -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        android:scaleType="centerInside"
        android:padding="5dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:text="Missed Payments"
        android:textColor="#0F0E0E"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="20dp"
        android:text="Birthday Holiday Savings"
        android:textColor="#687385"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="#1DED0F0F"
        android:orientation="horizontal"
        android:padding="18dp">

        <TextView
            android:id="@+id/txtOverdueCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3"
            android:textColor="#009688"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="Members with overdue payments"
            android:textColor="#687385"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Member 1 -->

    <LinearLayout
        android:id="@+id/member1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#1D282626"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/txtMember1Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thandi Mkhize"
            android:textColor="#172B4D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Amount and days overdue -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMember1Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R500"
                    android:textColor="#D84315"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMember1DaysOverdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="5 days "
                    android:textColor="#090909"
                    android:textSize="16sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtMember1Overdue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Overdue"
                android:textColor="#D84315"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRemindMember1"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#00897B"
                android:backgroundTintMode="multiply"
                android:text="Remind"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </LinearLayout>

    <!-- Member 2 -->

    <LinearLayout
        android:id="@+id/member2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#1D424040"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/txtMember2Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sipho Ndlovu"
            android:textColor="#172B4D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMember2Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R500"
                    android:textColor="#D84315"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMember2DaysOverdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="10 days "
                    android:textColor="#0B0B0B"
                    android:textSize="16sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtMember2Overdue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Overdue"
                android:textColor="#D84315"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRemindMember2"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#00897B"
                android:text="Remind"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </LinearLayout>

    <!-- Member 3 -->

    <LinearLayout
        android:id="@+id/member3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#1D403E3E"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/txtMember3Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lerato Dlamini"
            android:textColor="#172B4D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMember3Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R500"
                    android:textColor="#D84315"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMember3DaysOverdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="5 days "
                    android:textColor="#090909"
                    android:textSize="16sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtMember3Overdue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Overdue"
                android:textColor="#D84315"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRemindMember3"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#00897B"
                android:text="Remind"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </LinearLayout>

    <!-- Member 4 -->

    <LinearLayout
        android:id="@+id/member4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtMember4Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nomsa Zulu"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#172B4D"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMember4Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R500"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#D84315"/>

                <TextView
                    android:id="@+id/txtMember4DaysOverdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 days overdue"
                    android:textSize="13sp"
                    android:textColor="#687385"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtMember4Overdue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overdue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#D84315"
                android:layout_marginStart="8dp"/>

            <Button
                android:id="@+id/btnRemindMember4"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Remind"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00897B"
                android:layout_marginStart="8dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Keep RecyclerView for dynamic data -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMissedPayments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"/>

</LinearLayout>