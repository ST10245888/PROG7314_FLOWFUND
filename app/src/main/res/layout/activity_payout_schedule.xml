<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- BACK BUTTON -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:padding="5dp" />

        <!-- LOGO + PAGE TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- FlowFund Logo -->
            <ImageView
                android:id="@+id/imgFlowFundLogo"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:contentDescription="FlowFund Logo"
                android:src="@drawable/flowfund_logo"
                android:scaleType="fitCenter" />

            <!-- Payout Schedule -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Payout Schedule"
                android:textColor="#172B4D"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- GROUP NAME -->
        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="0dp"
            android:text="Birthday Holiday Savings"
            android:textColor="#687385"
            android:textSize="16sp" />

        <!-- NEXT PAYOUT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- NEXT PAYOUT LABEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT PAYOUT"
                android:textColor="#687385"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- MEMBER NAME -->
            <TextView
                android:id="@+id/txtNextMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thandi M."
                android:textColor="#172B4D"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- PAYOUT DATE -->
            <TextView
                android:id="@+id/txtNextPayoutDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="25 September 2026"
                android:textColor="#687385"
                android:textSize="16sp" />

            <!-- PAYOUT AMOUNT -->
            <TextView
                android:id="@+id/txtNextAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="R2,000"
                android:textColor="#00897B"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FULL ROTATION TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:text="Full Rotation"
            android:textColor="#172B4D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- FULL ROTATION -->
        <LinearLayout
            android:id="@+id/payoutRotationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MEMBER 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thandi M."
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="25 September 2026"
                    android:textColor="#687385"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- MEMBER 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sakhile D."
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="25 October 2026"
                    android:textColor="#687385"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- MEMBER 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ayanda N."
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="25 November 2026"
                    android:textColor="#687385"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- MEMBER 4 -->

            <!-- MEMBER 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lebo K."
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="25 January 2027"
                    android:textColor="#687385"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- MEMBER 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mandla P."
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="25 February 2027"
                    android:textColor="#687385"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>