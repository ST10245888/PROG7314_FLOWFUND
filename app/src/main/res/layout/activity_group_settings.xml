<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- BACK BUTTON -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:padding="5dp" />

        <!-- LOGO + PAGE TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/imgFlowFundLogo"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:contentDescription="FlowFund Logo"
                android:src="@drawable/flowfund_logo"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/txtGroupSettingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Group Settings"
                android:textColor="#040404"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Group Name -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="GROUP"
            android:textColor="#0B0A0A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Group Name"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtGroupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter group name"
            android:inputType="textCapSentences"
            android:maxLength="50"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <!-- Contribution Amount -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contribution Amount"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtContributionAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 500.00"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <!-- Contribution Frequency -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contribution Frequency"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerFrequency"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp" />

        <!-- Currency -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Currency"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerCurrency"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp" />

        <!-- Cycle Start Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cycle Start Date"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCycleStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select cycle start date"
            android:focusable="false"
            android:clickable="true"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />

        <!-- RULES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="RULES "
            android:textColor="#0B0A0A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Contribution Rules -->
        <LinearLayout
            android:id="@+id/layoutContributionRules"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="15dp"
            android:paddingRight="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Contribution Rules"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtContributionRulesArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textColor="#0B0A0A"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Late Payment Rules -->
        <LinearLayout
            android:id="@+id/layoutLatePaymentRules"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="15dp"
            android:paddingRight="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Late Payment Rules"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLatePaymentRulesArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textColor="#0B0A0A"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Member Permissions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="MEMBER PERMISSIONS"
            android:textColor="#0B0A0A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchMemberContributions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Members can view contributions"
            android:textSize="15sp"
            android:checked="true" />

        <Switch
            android:id="@+id/switchMemberMeetings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Members can view meetings"
            android:textSize="15sp"
            android:checked="true" />

        <Switch
            android:id="@+id/switchMemberInvite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Members can invite others"
            android:textSize="15sp"
            android:layout_marginBottom="25dp" />

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveGroupSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="25dp"
            android:backgroundTint="#0ED93B"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <!-- Danger Zone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="DANGER ZONE"
            android:textColor="#C62828"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leaving this group will remove you from the group's member list."
            android:textSize="14sp"
            android:textColor="#687385"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnLeaveGroup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Leave Group"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:backgroundTint="#FFEBEE"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>