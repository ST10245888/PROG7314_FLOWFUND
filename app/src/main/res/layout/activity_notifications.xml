<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="#172B24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Notifications"
            android:textColor="#172B24"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Notifications Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stay updated on your stokvel activity"
                android:textColor="#66756D"
                android:textSize="14sp" />

            <!-- Contribution Reminder -->
            <LinearLayout
                android:id="@+id/notificationContribution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/flowfund_card_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_reminder"
                    android:contentDescription="Notification icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your contribution of R500 is due in 3 days"
                        android:textColor="#172B24"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="2h ago"
                        android:textColor="#839087"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#198754" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#DDE5DF" />

            <!-- Meeting Reminder -->
            <LinearLayout
                android:id="@+id/notificationMeeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/flowfund_card_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="29dp"
                    android:layout_height="30dp"
                    android:contentDescription="Notification icon"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="September meeting starts in 24 hours"
                        android:textColor="#172B24"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="5h ago"
                        android:textColor="#839087"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#198754" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#DDE5DF" />

            <!-- Missed Payment Notification -->
            <LinearLayout
                android:id="@+id/notificationMissedPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/flowfund_card_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="30dp"
                    android:contentDescription="Notification icon"
                    android:src="@drawable/ic_error" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mavuso D., missed the August contribution"
                        android:textColor="#172B24"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="1d ago"
                        android:textColor="#839087"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#198754" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#DDE5DF" />

            <!-- Payment Confirmed Notification -->
            <LinearLayout
                android:id="@+id/notificationConfirmed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/flowfund_card_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_check"
                    android:contentDescription="Notification icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your July contribution was confirmed"
                        android:textColor="#172B24"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="3h ago"
                        android:textColor="#839087"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Read Notification -->
                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#F5F7FA" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#DDE5DF" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
