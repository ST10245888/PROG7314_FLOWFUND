<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="30dp">

        <!-- TOP HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <!-- FlowFund Logo -->
            <ImageView
                android:id="@+id/imgFlowFundLogo"
                android:layout_width="141dp"
                android:layout_height="94dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="FlowFund Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/flowfund_logo" />

            <!-- Notification Icon -->
            <ImageButton
                android:id="@+id/btnNotifications"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_notifications"
                android:contentDescription="Notifications"
                android:padding="10dp"
                android:src="@drawable/ic_notifications"
                app:tint="#222222" />

        </RelativeLayout>


        <!-- GREETING -->
        <TextView
            android:id="@+id/txtGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Good evening, Sakhile"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Here's your stokvel overview"
            android:textColor="#777777"
            android:textSize="24sp" />


        <!-- TOTAL CONTRIBUTIONS -->

        <LinearLayout
            android:id="@+id/cardTotalContributions"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="25dp"
            android:background="#0CAF45"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Contributions"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Amount -->
            <TextView
                android:id="@+id/txtTotalContributions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="R 1,000.00"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Monthly Change -->
            <TextView
                android:id="@+id/txtContributionChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="▣  12% this month"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>


        <!-- YOUR GROUPS HEADER -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp">

            <!-- Your Groups -->
            <TextView
                android:id="@+id/txtYourGroups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Your Groups"
                android:textColor="#222222"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- View All -->
            <TextView
                android:id="@+id/txtViewAllGroups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="5dp"
                android:text="View all"
                android:textColor="#0CAF45"
                android:textSize="24sp"
                android:textStyle="bold" />

        </RelativeLayout>


        <!-- FAMILY STOKVEL CARD -->

        <LinearLayout
            android:id="@+id/cardFamilyStokvel"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_group_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="15dp">

            <!-- Family Icon -->
            <ImageView
                android:id="@+id/imgFamilyGroup"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Family Stokvel"
                android:src="@drawable/ic_family"
                app:tint="#0CAF45" />

            <!-- Family Information -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#5DC5C2C2"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <!-- Group Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Family Stokvel"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Members -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="11 Members"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <!-- Next Payout -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Next payout"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <!-- Payout Amount and Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="R2,000 - 20 Aug"
                    android:textColor="#444444"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Right Arrow -->
            <TextView
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text=">"
                android:textColor="#0EA730"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- SPACE BETWEEN GROUP CARDS -->

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />


        <!-- FRIENDS FUND CARD -->

        <LinearLayout
            android:id="@+id/cardFriendsFund"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_group_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="15dp">

            <!-- Friends Icon -->
            <ImageView
                android:id="@+id/imgFriendsGroup"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Friends Fund"
                android:src="@drawable/ic_friends"
                app:tint="#0CAF45" />

            <!-- Friends Information -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#5DCCC7C7"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <!-- Group Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Friends Fund"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Members -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="9 Members"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <!-- Next Payout -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Next payout"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <!-- Payout Amount and Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="R1,000 - 25 Aug"
                    android:textColor="#444444"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Right Arrow -->
            <TextView
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text=">"
                android:textColor="#0EA730"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- UPCOMING CONTRIBUTION -->

        <LinearLayout
            android:id="@+id/cardUpcomingContribution"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_group_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="15dp">

            <!-- Contribution Icon -->
            <ImageView
                android:id="@+id/imgUpcomingContribution"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Upcoming Contribution"
                android:src="@drawable/ic_contribution"
                app:tint="#0CAF45" />

            <!-- Contribution Information -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#5DCAC3C3"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Contribution"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Group -->
                <TextView
                    android:id="@+id/txtUpcomingGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Family Stokvel"
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <!-- Date and Amount -->
                <TextView
                    android:id="@+id/txtUpcomingAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="18 Aug - R600"
                    android:textColor="#444444"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Right Arrow -->
            <TextView
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text=">"
                android:textColor="#0EA730"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>

</ScrollView>